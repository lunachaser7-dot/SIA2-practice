# Rename this file to .env and fill in your MySQL credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=church_finance_db
JWT_SECRET=your_jwt_secret

# If your local MySQL root user has no password, leave DB_PASSWORD blank.
# If you have a password, set it here instead of leaving it blank.
